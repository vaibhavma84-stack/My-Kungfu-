<?xml version="1.0" encoding="utf-8"?>
<!--
    The player used while stepping through frames, and only then.

    Media3's own advice is to leave a player on a SurfaceView, which is what
    the ordinary one uses: it hands frames straight to the display without
    another copy, which is what makes 4K on a phone practical at all. What a
    SurfaceView will not do is be scaled and moved about, because the surface
    is a separate layer that the view hierarchy does not really own.

    Zooming into a frame needs exactly that. So frame mode swaps in this one,
    backed by a TextureView, which is an ordinary view and can be transformed
    like one. It costs a copy per frame -- paid only while paused and looking
    closely at a still, which is the one time nobody is counting.
-->
<androidx.media3.ui.PlayerView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/frame_player"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    app:surface_type="texture_view"
    app:use_controller="false"
    app:resize_mode="fit" />
