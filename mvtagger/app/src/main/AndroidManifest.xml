<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The only permission needed. Folders are reached through the Storage
         Access Framework, which grants access to the folders the user picks
         rather than to all their storage. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Only for "keep playing when the app is put away", which is off unless
         asked for. ExoPlayer holds the lock while something is playing and
         drops it the moment it stops; without it the processor idles a minute
         after the screen goes off and takes the sound with it. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:name=".MvTaggerApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.MVTagger">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

    <!-- Needed on Android 11+ to offer "open in another player": without it the
         chooser cannot see which apps handle video. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="video/*" />
        </intent>
    </queries>
</manifest>
