<?xml version="1.0" encoding="utf-8"?>
<!-- One day. Deliberately only three views.
     The first version built a nested chip layout per job: about five hundred
     RemoteViews for a month, which is where a widget quietly stops rendering.
     The jobs are one TextView with a line each instead. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1"
    android:orientation="vertical"
    android:paddingStart="2dp"
    android:paddingEnd="2dp"
    android:paddingTop="2dp"
    android:paddingBottom="3dp">

    <TextView
        android:id="@+id/cell_num"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#B8C4CE"
        android:textSize="10sp"
        android:maxLines="1" />

    <TextView
        android:id="@+id/cell_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#DCE4EB"
        android:textSize="8sp"
        android:lineSpacingExtra="1dp"
        android:maxLines="4"
        android:ellipsize="end" />
</LinearLayout>
